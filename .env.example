# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# 宿主机访问端口（浏览器打开 http://<host>:APP_PORT）
APP_PORT=8787

# 容器内监听端口：一般不用改；如要改，APP_PORT 与 PORT 一起改
PORT=8787

# 访问口令：留空=不校验；设了就需访问 /?token=<TOKEN> 一次
TOKEN=

# 内置红果解密流的最大并发数
MAX_STREAMS=6

# 1=允许 /api/media、/api/hls 代理内网地址（默认 0 拒绝，防 SSRF）
ALLOW_PRIVATE_MEDIA=0

# 时区
TZ=Asia/Shanghai
